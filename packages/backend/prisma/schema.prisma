// Prisma schema for Idea Hub Talent Acquisition Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core entity models

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String   @db.VarChar(255)
  role         String   @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@map("users")
}

model Event {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  type        String   @db.VarChar(50)
  date        DateTime
  description String?  @db.Text
  goals       Json?
  companyId   String?  @map("company_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company       Company?           @relation(fields: [companyId], references: [id])
  venues        EventVenue[]
  studentBodies EventStudentBody[]
  tasks         Task[]

  @@index([companyId])
  @@index([date])
  @@map("events")
}

model Venue {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(255)
  location        String?   @db.VarChar(255)
  capacity        Int?
  rating          Decimal?  @db.Decimal(3, 2)
  amenities       Json?
  contactInfo     Json?     @map("contact_info")
  status          String    @db.VarChar(50)
  lastContactDate DateTime? @map("last_contact_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  events        EventVenue[]
  statusHistory StatusHistory[]

  @@index([status])
  @@map("venues")
}

model Company {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  industry    Json?
  techStack   Json?    @map("tech_stack")
  culture     String?  @db.Text
  hiringNeeds Json?    @map("hiring_needs")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  events     Event[]
  skillsGaps SkillsGap[]

  @@map("companies")
}

model University {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @db.VarChar(255)
  location             String?  @db.VarChar(255)
  programs             Json?
  strengths            Json?
  industryPartnerships Json?    @map("industry_partnerships")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  clubs Club[]

  @@map("universities")
}

model Club {
  id             String   @id @default(uuid()) @db.Uuid
  universityId   String   @map("university_id") @db.Uuid
  name           String   @db.VarChar(255)
  focusAreas     Json?    @map("focus_areas")
  memberCount    Int?     @map("member_count")
  activityLevel  String?  @db.VarChar(50)
  recentProjects Json?    @map("recent_projects")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id])

  @@map("clubs")
}

model Candidate {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String?  @db.VarChar(255)
  email              String?  @db.VarChar(255)
  platforms          Json?
  skills             Json?
  experienceLevel    String?  @map("experience_level") @db.VarChar(50)
  notableProjects    Json?    @map("notable_projects")
  relevanceScore     Decimal? @map("relevance_score") @db.Decimal(5, 2)
  skillsMatchScore   Decimal? @map("skills_match_score") @db.Decimal(5, 2)
  preScreeningStatus String?  @map("pre_screening_status") @db.VarChar(50)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  preScreeningSessions PreScreeningSession[]

  @@index([skills], type: Gin)
  @@map("candidates")
}

model Task {
  id           String    @id @default(uuid()) @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  title        String    @db.VarChar(255)
  description  String?   @db.Text
  explanation  String?   @db.Text
  priority     Int?
  dependencies Json?
  completed    Boolean   @default(false)
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("tasks")
}

model Reminder {
  id           String    @id @default(uuid()) @db.Uuid
  entityId     String    @map("entity_id") @db.Uuid
  entityType   String    @map("entity_type") @db.VarChar(50)
  draftSubject String?   @map("draft_subject") @db.VarChar(255)
  draftBody    String?   @map("draft_body") @db.Text
  approved     Boolean   @default(false)
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("reminders")
}

model SkillsGap {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  skill            String   @db.VarChar(255)
  proficiencyLevel String?  @map("proficiency_level") @db.VarChar(50)
  priority         String?  @db.VarChar(50)
  currentCount     Int?     @map("current_count")
  targetCount      Int?     @map("target_count")
  gap              Int?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("skills_gaps")
}

model PreScreeningSession {
  id          String    @id @default(uuid()) @db.Uuid
  candidateId String    @map("candidate_id") @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  status      String    @db.VarChar(50)
  questions   Json?
  responses   Json?
  report      Json?
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@map("pre_screening_sessions")
}

model StatusHistory {
  id             String   @id @default(uuid()) @db.Uuid
  entityId       String   @map("entity_id") @db.Uuid
  entityType     String   @map("entity_type") @db.VarChar(50)
  previousStatus String?  @map("previous_status") @db.VarChar(50)
  newStatus      String   @map("new_status") @db.VarChar(50)
  notes          String?  @db.Text
  timestamp      DateTime @default(now())

  venue Venue? @relation(fields: [entityId], references: [id])

  @@index([entityId, entityType])
  @@map("status_history")
}

// Junction tables

model EventVenue {
  eventId String @map("event_id") @db.Uuid
  venueId String @map("venue_id") @db.Uuid

  event Event @relation(fields: [eventId], references: [id])
  venue Venue @relation(fields: [venueId], references: [id])

  @@id([eventId, venueId])
  @@map("event_venues")
}

model EventStudentBody {
  eventId         String @map("event_id") @db.Uuid
  studentBodyId   String @map("student_body_id") @db.Uuid
  studentBodyType String @map("student_body_type") @db.VarChar(50)
  status          String @db.VarChar(50)

  event Event @relation(fields: [eventId], references: [id])

  @@id([eventId, studentBodyId])
  @@map("event_student_bodies")
}
